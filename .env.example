# PredictAP Web
PREDICTAP_WEB_PORT=8503
PREDICTAP_PACKAGE_DIR=/absolute/path/to/PredictAP_python
PREDICTAP_REFERENCE_DATA_HOST_PATH=/absolute/path/to/Predixcan/data
PREDICTAP_DATA_DIR=/reference_data
SAVE_TMP_DIR=/app/save_tmp
STREAMLIT_PORT=8501
STREAMLIT_MAX_UPLOAD_MB=500

# GA adapter: disabled | mock | precomputed | http
GA_ADAPTER_MODE=precomputed
GA_API_BASE_URL=http://gpu-server:8080
GA_CONNECT_TIMEOUT_SECONDS=10
GA_READ_TIMEOUT_SECONDS=300

# Confirmed first-stage selection policy
GA_SELECTION_COLUMN=ks.test
GA_SELECTION_VALUE=Sig.
GA_GENE_COLUMN=gene
GA_FID_COLUMN=FID
GA_IID_COLUMN=IID

# Thesis-supported model scope
GA_SUPPORTED_POPULATION=EAS
GA_SUPPORTED_TISSUE=Lung
# Set after the approved weight database is chosen.
GA_MODEL_KEY=

# Existing-result reporting mode. These are paths visible inside the container.
GA_DEMO_PREDIXCAN_PATH=
GA_PRECOMPUTED_EXPRESSION_PATH=/ga_demo/predicted_expression.csv
GA_PRECOMPUTED_SUMMARY_PATH=/ga_demo/predicted_summary.csv
GA_PRECOMPUTED_SAMPLE_ID_REGEX=^(GSM[0-9]+)
GA_ACCEPTED_QC_STATUSES=OK
GA_MODEL_OUTPUT_DIR=/ga_model
GA_MODEL_DISPLAY_NAME=Existing Lung/EAS GA model
GA_MODEL_GTEX_VERSION=unverified
GA_MODEL_CV_METHOD=LOOCV
GA_MODEL_SIGN_MODE=Sign-flip enabled
PREDICTAP_REFERENCE_LABEL=Mounted PredictAP EAS reference (release unverified)

# Host paths used by Docker Compose volumes.
GA_PRECOMPUTED_EXPRESSION_HOST_PATH=/absolute/path/to/predicted_expression.csv
GA_PRECOMPUTED_SUMMARY_HOST_PATH=/absolute/path/to/predicted_summary.csv
GA_RESULTS_ROOT=/ga_results
GA_RESULTS_HOST_PATH=/absolute/path/to/GA_Result
# Optional temporary demo source for complete LOOCV/Sign figures.
GA_DIAGNOSTICS_TEST_FALLBACK_DIR=

# GA Gene Expression Prediction
GA_WEIGHTS_DB_PATH=/ga_weights/V4_3Fold_Sign_weights.db
GA_WEIGHTS_DB_HOST_PATH=/absolute/path/to/GA_Weight_DataBase
GA_WEIGHT_COLUMN=GA_W
PLINK2_CMD=plink2

# Required by NCBI Entrez for live human gene lookup.
NCBI_ENTREZ_EMAIL=your-email@example.org
