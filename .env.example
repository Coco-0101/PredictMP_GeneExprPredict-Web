# ── Web server ────────────────────────────────────────────
PREDICTMP_WEB_PORT=8503              # host port (bound to 127.0.0.1)
STREAMLIT_PORT=8501                  # port inside the container
STREAMLIT_MAX_UPLOAD_MB=10000
PREDICTMP_UID=1009                   # host user/group the container runs as (`id` on the host)
PREDICTMP_GID=100

# ── Uploads / results ─────────────────────────────────────
RESULTS_DIR=/app/session_results     # inside the container; Docker volume predictmp_geneexprpredict-web_session_results
RESULTS_RETENTION_DAYS=7             # session folders older than this are deleted automatically

# ── PredictMP (PredictAP percentile rank) ─────────────────
# Host folder holding tissue/, result_table/, ks/ (built by PredictMP/code/08_build_package_data.py)
PREDICTMP_REFERENCE_DATA_HOST_PATH=/absolute/path/to/PredictMP/data
# Read by the PredictAP package itself; keep this name
PREDICTAP_DATA_DIR=/reference_data

# ── GA-calibrated gene expression prediction ──────────────
GA_WEIGHTS_DB_HOST_PATH=/absolute/path/to/GA_Weight_DataBase
GA_WEIGHTS_DB_PATH=/ga_weights/V4_3Fold_Sign_weights.db   # inside the container
GA_WEIGHT_COLUMN=GA_W
PLINK2_CMD=plink2
